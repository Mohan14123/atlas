{
  "name": "atlas-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "ts-node -r tsconfig-paths/register src/api/index.ts",
    "dev:scheduler": "ts-node -r tsconfig-paths/register src/scheduler/index.ts",
    "dev:worker": "ts-node -r tsconfig-paths/register src/worker/index.ts",
    "migrate": "prisma migrate dev --config prisma.config.ts",
    "migrate:prod": "prisma migrate deploy --config prisma.config.ts",
    "generate": "prisma generate --config prisma.config.ts",
    "build": "tsc",
    "test": "jest --runInBand --forceExit",
    "test:concurrency": "jest tests/concurrency --runInBand --forceExit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.2.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
